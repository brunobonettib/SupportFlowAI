{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Analysis": {
    "Provider": "Ollama"
  },
  "Ollama": {
    "Model": "gemma3:4b",
    "TimeoutSeconds": 120,
    "MaxOutputTokens": 1000,
    "ContextTokens": 8192
  },
  "OpenAI": {
    "Model": "gpt-6-luna",
    "ReasoningEffort": "none",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 1000
  }
}
